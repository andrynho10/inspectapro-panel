# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
# true = muestra el aviso de demo y deshabilita eliminar
NEXT_PUBLIC_DEMO_MODE=true
# Asistente con IA (solo servidor; nunca usar el prefijo NEXT_PUBLIC_)
GEMINI_API_KEY=tu-clave-de-google-ai-studio
# Opcional: modelos en orden de preferencia y límite diario de preguntas
# GEMINI_MODELOS=gemini-3.5-flash,gemini-flash-lite-latest
# ASISTENTE_LIMITE_DIARIO=60
